NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Privileged server key (cron, webhooks, AI build status writes). Server-only:
# never NEXT_PUBLIC_. Prefer a Supabase secret key (sb_secret_..., one per
# backend, individually revocable); the legacy service_role JWT is the fallback.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend transactional email
RESEND_API_KEY=re_...
RESEND_FROM_ADDRESS=AOS <hello@yourdomain.com>

# Vercel Cron auth — any random string. Vercel injects this into Authorization
# header for scheduled jobs configured in vercel.json.
CRON_SECRET=replace-with-a-random-string

# Comma-separated email allowlist for the /founders analytics page.
# Lowercased on compare; whitespace ignored.
FOUNDERS_EMAILS=joshf5252@gmail.com

# Resend webhook signing secret (Svix-style). Get from the Resend dashboard
# when you create the webhook endpoint. Format: whsec_<base64>.
RESEND_WEBHOOK_SECRET=whsec_replace-me

# Stripe — Pro tier billing.
# Use test keys (sk_test_..., whsec_...) until launch.
STRIPE_SECRET_KEY=sk_test_replace-me
STRIPE_WEBHOOK_SECRET=whsec_replace-me
# The Pro monthly price object id from the Stripe dashboard (price_...).
STRIPE_PRO_PRICE_ID=price_replace-me

# AI Build — every value below is required before a build can start.
# AI_BUILD_VERCEL_TOKEN / _TEAM_ID: a Vercel team used ONLY for generated apps
#   (never the team hosting AOS), and a token scoped to that team alone.
# AI_BUILD_ANTHROPIC_KEY: the key generated apps call Claude with. Create it in
#   a dedicated Claude Console workspace with a workspace spend limit: that
#   limit is the only hard spend ceiling. Not the same key as ANTHROPIC_API_KEY.
# AI_BUILD_KIT_SUPABASE_*: the shared kit Supabase project (interest list and
#   the global request limiter; apply starter-kit/supabase/schema.sql). Its
#   public URL and anon/publishable key only.
AI_BUILD_VERCEL_TOKEN=
AI_BUILD_VERCEL_TEAM_ID=
AI_BUILD_ANTHROPIC_KEY=
AI_BUILD_KIT_SUPABASE_URL=
AI_BUILD_KIT_SUPABASE_ANON_KEY=
# Optional request caps for generated apps (enforced globally by the limiter).
# AI_BUILD_KIT_DAILY_REQUEST_CAP=200         # per app per UTC day
# AI_BUILD_KIT_GLOBAL_DAILY_REQUEST_CAP=1000 # all apps per UTC day
# AI_BUILD_KIT_RATE_LIMIT_PER_IP=8           # per client per 10 minutes
