NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required for the nudge cron route (server-side only — never expose)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend transactional email
RESEND_API_KEY=re_...
RESEND_FROM_ADDRESS=AOS <hello@yourdomain.com>

# Vercel Cron auth — any random string. Vercel injects this into Authorization
# header for scheduled jobs configured in vercel.json.
CRON_SECRET=replace-with-a-random-string

# Comma-separated email allowlist for the /founders analytics page.
# Lowercased on compare; whitespace ignored.
FOUNDERS_EMAILS=joshf5252@gmail.com

# Resend webhook signing secret (Svix-style). Get from the Resend dashboard
# when you create the webhook endpoint. Format: whsec_<base64>.
RESEND_WEBHOOK_SECRET=whsec_replace-me

# Stripe — Pro tier billing.
# Use test keys (sk_test_..., whsec_...) until launch.
STRIPE_SECRET_KEY=sk_test_replace-me
STRIPE_WEBHOOK_SECRET=whsec_replace-me
# The Pro monthly price object id from the Stripe dashboard (price_...).
STRIPE_PRO_PRICE_ID=price_replace-me
