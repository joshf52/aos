# Supply-chain pins — mirrors the founder's global ~/.npmrc so CI/Vercel/fresh
# clones get the same protection. See CLAUDE.md "Supply-chain posture" for what
# is enforced where: npm 11+ (Node 24) honors min-release-age; the npm 10.x
# bundled with Node <= 22 (Vercel's default image) SILENTLY ignores it.
min-release-age=7
save-exact=true
