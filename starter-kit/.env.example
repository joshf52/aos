ANTHROPIC_API_KEY=
# The shared kit Supabase project: interest list + the global request limiter
# (kit_admit_ai in supabase/schema.sql).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional AI controls — defaults live in lib/ai.ts.
# AI_MODEL=claude-sonnet-5-5        # only models priced in lib/ai.ts are accepted
# AI_MAX_INPUT_CHARS=6000
# AI_MAX_OUTPUT_TOKENS=2000         # bounds worst-case cost per request
# AI_RATE_LIMIT_PER_IP=8            # per AI_RATE_LIMIT_WINDOW_SECONDS
# AI_RATE_LIMIT_WINDOW_SECONDS=600
# AI_DAILY_REQUEST_CAP=200          # per app per UTC day
# AI_GLOBAL_DAILY_REQUEST_CAP=1000  # all apps on the kit Supabase, per UTC day
# AI_REQUIRE_GLOBAL_LIMIT=1         # AOS sets this: no limiter answer, no Claude call
# AI_TIMEOUT_SECONDS=50
# None of these is a spend ceiling. Put a workspace spend limit on the key.
